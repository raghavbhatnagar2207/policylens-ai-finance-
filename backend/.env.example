# PolicyLens AI — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# Environment: development | production | testing
FLASK_ENV=development

# Database Connection
# Development (default SQLite):
DATABASE_URL=sqlite:///policylens.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://policylens_user:YOUR_STRONG_PASSWORD@localhost:5432/policylens

# JWT Secret Key (CRITICAL: MUST be at least 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Storage Backend: local | s3
STORAGE_BACKEND=local
# ARTIFACT_STORAGE_PATH=/app/app/ml/artifacts

# Rate Limiter Storage: memory:// for local dev, redis://:password@host:port/0 for production
RATELIMIT_STORAGE_URI=memory://
